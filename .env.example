# Copy to .env.local — never commit secrets.
# Production: set the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=MGK Reminder <onboarding@resend.dev>
# Dev only: Resend sandbox sends to this inbox instead of user emails
RESEND_DEV_TO=

CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# App variant: beta (demo login) | release (production, no demo)
# Vercel → set per environment: Production=release, Preview/beta project=beta
NEXT_PUBLIC_APP_VARIANT=release

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourcompany.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# After deploy — Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://your-app.vercel.app
# Redirect URLs: https://your-app.vercel.app/auth/callback

# Cron (vercel.json): runs 01:00 UTC = 08:00 WIB daily
